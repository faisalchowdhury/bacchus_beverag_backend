# ---------------------------------------------------------------------------
# Production URL settings for the deployed backend (faisal6001.ssh.bd)
#
# Copy these values into the .env on the SERVER. They are the settings that
# differ from local development — everything else (DATABASE_URL, JWT_SECRET_KEY,
# SMTP credentials, Stripe, Cloudinary) stays as it already is.
#
# Two of these were wrong in production and caused real breakage:
#
#   QUOTE_ACCEPT_BASE_URL  was unset, so it fell back to CLIENT_URL
#                          (http://localhost:5173). Every "Accept Quote" button
#                          emailed to a client was a dead link.
#
#   EXTRA_CORS_ORIGINS     did not list the dashboard origin, so every API call
#                          from https://faisal6003.ssh.bd was blocked by the
#                          browser before it reached the server.
# ---------------------------------------------------------------------------

NODE_ENV=production
PORT=6001

# The public website. Drives CORS and is the default for the two URLs below.
CLIENT_URL="https://faisal6000.ssh.bd"

# This API's own public origin.
PUBLIC_BASE_URL="https://faisal6001.ssh.bd"

# Brand site linked from email footers.
BRAND_URL="https://faisal6000.ssh.bd"

# Admin dashboard. Linked from staff welcome emails and from the
# "quote accepted" notification.
DASHBOARD_URL="https://faisal6003.ssh.bd"

# Origins allowed to call this API from a browser, comma separated.
# The dashboard MUST be here — it is a different origin from the website.
EXTRA_CORS_ORIGINS="https://faisal6000.ssh.bd,https://faisal6003.ssh.bd"

# Where the "Accept Quote" button in a client's estimate email points.
# Set this explicitly rather than relying on the CLIENT_URL fallback.
QUOTE_ACCEPT_BASE_URL="https://faisal6000.ssh.bd"

# How long a client has to click Accept before the link needs reissuing.
QUOTE_ACCEPT_TOKEN_DAYS=30
