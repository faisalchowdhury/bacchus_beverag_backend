# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_NAME="Bacchus Beverages"
NODE_ENV=development
PORT=6001

# ---------------------------------------------------------------------------
# Database & auth
# ---------------------------------------------------------------------------
DATABASE_URL="mongodb://127.0.0.1:27017/my-app"
JWT_SECRET_KEY="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# ---------------------------------------------------------------------------
# URLs
# ---------------------------------------------------------------------------
CLIENT_URL="http://localhost:5173"          # frontend origin (CORS + redirects)
PUBLIC_BASE_URL="https://faisal6000.ssh.bd"     # public URL of this API
BRAND_URL="http://localhost:5173"           # link used in emails
DASHBOARD_URL="http://localhost:4010"       # admin dashboard, linked from staff emails

# Where the "Accept Quote" button in a client's estimate email points. This is
# client-facing, so it must be the public website, not the dashboard.
QUOTE_ACCEPT_BASE_URL="http://localhost:5173"
# How long a client has to click Accept before the link needs reissuing.
QUOTE_ACCEPT_TOKEN_DAYS=30
EXTRA_CORS_ORIGINS=""                       # comma separated extra origins

# ---------------------------------------------------------------------------
# First admin account (seeded on startup)
# ---------------------------------------------------------------------------
SEED_ADMIN_NAME="Admin"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="Admin@1234"

# ---------------------------------------------------------------------------
# Mail — required for OTP, password reset and quote estimate emails
#
# Two options. Gmail takes priority whenever both of its values are filled in;
# otherwise the SMTP_* block below is used.
#
# Gmail needs an App Password (Google Account → Security → 2-Step Verification
# → App passwords), NOT the account password. Spaces in it are ignored.
# Gmail always sends as the authenticated account, so SMTP_FROM has no effect
# on this path.
# ---------------------------------------------------------------------------
Nodemailer_GMAIL="you@gmail.com"
Nodemailer_GMAIL_PASSWORD="abcd efgh ijkl mnop"

# Generic SMTP — used only when the Gmail values above are empty.
SMTP_HOST="smtp.example.com"
SMTP_PORT=465
SMTP_USER="noreply@example.com"
SMTP_PASSWORD=""
SMTP_FROM="noreply@example.com"
# EMAIL_LOGO_URL=                           # defaults to PUBLIC_BASE_URL/images/logo.png

# ---------------------------------------------------------------------------
# Quote requests
# ---------------------------------------------------------------------------
# Inbox that receives a copy of every submitted quote. Comma separated for
# several recipients. Defaults to SMTP_FROM when unset.
QUOTE_NOTIFY_EMAIL="bookings@example.com"
# Venue name used in client-facing quote emails.
VENUE_NAME="Chateau Des Fleures"

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
UPLOAD_FOLDER="public/images"
MAX_FILE_SIZE=52428800                      # 50MB

# ---------------------------------------------------------------------------
# Stripe (optional — checkout + webhook)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=""                        # sk_test_... — never expose to the frontend
STRIPE_PUBLISH_KEY=""
STRIPE_WEBHOOK_SECRET=""                    # whsec_... from the Stripe CLI / dashboard
PRODUCT_PRICE_ID=""                         # price_... used by the default checkout

# ---------------------------------------------------------------------------
# Firebase push notifications (optional — push no-ops when unset)
# ---------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT_PATH="src/config/firebase-service-account.json"

# ---------------------------------------------------------------------------
# Cloudinary (optional)
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
